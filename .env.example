# ==============================================================================
# TAVILO — Environment Configuration
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Audius Open Network (Active by default, zero configuration required)
AUDIUS_APP_NAME=TAVILO

# Jamendo Music API (Optional - Register at https://developer.jamendo.com/ to obtain a Client ID)
# When provided, Jamendo catalog search and streaming are automatically enabled.
JAMENDO_CLIENT_ID=

# YouTube Data API v3 (Optional - for extended catalog metadata and official embeds)
YOUTUBE_API_KEY=

# Hosted PostgreSQL / Database URL (Optional - for cloud syncing across devices)
DATABASE_URL=
